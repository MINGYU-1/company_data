   "source": [
    "import pandas as pd\n",
    "\n",
    "data = pd.read_csv('./data_csv/강원특별자치도_식품자동판매기업.csv', encoding='cp949')\n",
    "\n",
    "cols = ['남성종사자수', '여성종사자수', '총직원수']\n",
    "\n",
    "# 전체 합계\n",
    "total = data[cols].sum()\n",
    "\n",
    "# 전체 평균\n",
    "mean = data[cols].mean()\n",
    "\n",
    "print(\"=== 직원수 총합 ===\")\n",
    "print(total)\n",
    "print(\"\\n=== 직원수 평균 ===\")\n",
    "print(mean)"
   ]
